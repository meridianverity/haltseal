{
  "$id": "https://meridianverity.com/schemas/haltseal/public-resolve/authority-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorized_amount_minor": {
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "currency": {
      "const": "USD"
    },
    "destination_id": {
      "enum": [
        "account_synthetic_a",
        "account_synthetic_b"
      ]
    },
    "merchant_id": {
      "enum": [
        "merchant_synthetic_alpha",
        "merchant_synthetic_beta"
      ]
    },
    "remaining_uses": {
      "maximum": 1,
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "enum": [
        "CURRENT",
        "REVOKED"
      ]
    },
    "terms": {
      "enum": [
        "ONE_TIME",
        "RECURRING_MONTHLY"
      ]
    }
  },
  "required": [
    "authorized_amount_minor",
    "currency",
    "merchant_id",
    "terms",
    "destination_id",
    "remaining_uses",
    "status"
  ],
  "title": "HALTSEAL Synthetic Authority v1",
  "type": "object"
}
